# Trust material: keys and trust roots the knowledge gate reads from the
# base branch. Changes need the owner's review and never merge
# automatically. (Patterns here are case-sensitive; the gate also treats
# other spellings of these names as trust material.)
/cli/knowledge/trust/ @airstand
/cli/knowledge/reattestation/trust-root.json @airstand
**/trust-root*.json @airstand
**/*approval-keys*.json @airstand

# The owner baseline choices (a change also needs an owner approval the gate
# verifies).
/cli/knowledge/repin-baselines.json @airstand

# The kill switch.
/factory/PAUSE @airstand

# The gate and the code its checks rest on.
/cli/internal/maintainer/knowledgegate/ @airstand
/cli/cmd/prufyx-maintainer/gate.go @airstand
/cli/internal/strictjson/ @airstand
/cli/internal/cncfcheck/packfiles.go @airstand
/cli/internal/projectcheck/packfiles.go @airstand
/cli/internal/lineattest/pack.go @airstand
/cli/internal/validation/ @airstand
/cli/internal/maintainer/evidencereattest/ @airstand
/cli/internal/extract/ @airstand

# The reviewed image-to-project registry and the code that interprets it. A
# wrong entry misidentifies a component, and loosening the matcher or the
# validator (tag schemes, distribution builds, roles that yield a version) is
# as dangerous as a wrong entry. The classification that turns a missing
# component into "absent" or "unknown", the detection paths that feed it and
# the collector's image projection are covered too. (The code owner is also
# the usual author, so until an independent reviewer exists the canonical-bytes
# test and the registry digest recorded in every bundle are the real controls.)
/cli/internal/imageidentity/ @airstand
/cli/internal/onecommand/ @airstand
/cli/internal/localcollector/component.go @airstand
/cli/internal/localcollector/component_aggregate.go @airstand
/cli/internal/observation/import.go @airstand
/cli/internal/maintainer/rulecheck/citeverify*.go @airstand

# Dependencies.
/cli/go.mod @airstand
/cli/go.sum @airstand
/cli/vendor/ @airstand

# Workflows, repository settings and this file.
/.github/ @airstand
