{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "prufyx",
          "version": "development",
          "informationUri": "https://github.com/prufyx/prufyx",
          "rules": [
            {
              "id": "kubernetes.served-api-removal.batch-v1beta1.1-24-0-to-1-25-0",
              "shortDescription": {
                "text": "Kubernetes 1.25 stops serving CronJob through batch/v1beta1"
              },
              "help": {
                "text": "Migrate the named manifests to batch/v1, then reassess the complete target apply set. Validate CRDs, stored objects, clients and API-server configuration separately."
              },
              "helpUri": "https://github.com/kubernetes/kubernetes/blob/4ce5a8954017644c5420bae81d72b09b735c21f0/staging/src/k8s.io/api/batch/v1beta1/zz_generated.prerelease-lifecycle.go",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "basis": "mechanical",
                "kind": "blocker"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "exitCode": 10,
          "exitCodeDescription": "BLOCKED: 1 problem must be fixed before this upgrade",
          "startTimeUtc": "2026-11-20T00:00:00Z",
          "toolExecutionNotifications": [
            {
              "level": "warning",
              "message": {
                "text": "1 manifest(s) use API versions that the review of Kubernetes 1.30 does not list as served - check those API versions against the Kubernetes 1.30 API reference by hand"
              },
              "descriptor": {
                "id": "API_VERSION_NOT_REVIEWED"
              },
              "properties": {
                "kind": "gap",
                "component": "kubernetes"
              }
            },
            {
              "level": "warning",
              "message": {
                "text": "2 document(s) contain unrendered templates - render them (for example with helm template) and scan the output"
              },
              "descriptor": {
                "id": "DOCUMENTS_TEMPLATED"
              },
              "properties": {
                "kind": "gap",
                "component": "kubernetes"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "kubernetes.served-api-removal.batch-v1beta1.1-24-0-to-1-25-0",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Kubernetes 1.25 stops serving CronJob through batch/v1beta1 — fix: Migrate the named manifests to batch/v1, then reassess the complete target apply set. Validate CRDs, stored objects, clients and API-server configuration separately."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "applyset.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "nightly-report",
                  "fullyQualifiedName": "CronJob default/nightly-report",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "prufyxResult/v1": "a8bb40aa45109de4535aadd151b8c83506c7de70fa6d58f391696e71875472f4"
          },
          "properties": {
            "component": "kubernetes",
            "hop": "1.24.17 -> 1.25",
            "basis": "mechanical",
            "match": "range"
          }
        }
      ],
      "properties": {
        "verdict": "BLOCKED",
        "headline": "BLOCKED: 1 problem must be fixed before this upgrade",
        "summary": {
          "blockers": 1,
          "gaps": 2,
          "passes": 0,
          "componentsDetected": 1,
          "componentsCovered": 1,
          "hops": 6,
          "documentsRead": 2,
          "documentsOmitted": 2,
          "notices": 0,
          "leads": 0,
          "unsupported": 0
        },
        "evaluatedAt": "2026-11-20T00:00:00Z",
        "inputDigest": "sha256:b98fcd349edbc6da86b0c9d4b792af158ac5c7558db0015339077cc23daec186",
        "knowledgeOrigin": "embedded",
        "knowledgeRevision": "cncf-2026-09-13.4",
        "knowledgeDigest": "sha256:54c40b58a69b6f99126b0dab01c99d2bf6be00a0f53adc57922a81640da17684",
        "engineContractDigest": "sha256:2cc7bb0052068bd2668d1c4419782bacd6fcbf34e73f9bf9cf08206cd1363fa6",
        "networkUsed": false,
        "omissions": [
          "node and kubelet version skew not evaluated",
          "Kubernetes: only API versions in the supplied manifests are evaluated; live cluster objects, CRDs, stored versions, admission and component configuration are not"
        ]
      }
    }
  ]
}
