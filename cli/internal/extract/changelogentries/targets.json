{
  "schema": "prufyx.io/changelog-targets/v1",
  "rows": [
    {
      "component": "alertmanager",
      "repo": "github.com/prometheus/alertmanager",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-slash-date",
      "boundaryStyles": ["main-unreleased-parenthesised"]
    },
    {
      "component": "antrea",
      "repo": "github.com/antrea-io/antrea",
      "form": "changelog-per-line-file",
      "path": "CHANGELOG/CHANGELOG-{line}.md",
      "headingStyle": "version-dash-date",
      "boundaryStyles": ["prerelease-linked-paren-date"]
    },
    {
      "component": "aws-ebs-csi-driver",
      "repo": "github.com/kubernetes-sigs/aws-ebs-csi-driver",
      "form": "post-tag"
    },
    {
      "component": "coredns",
      "repo": "github.com/coredns/coredns",
      "form": "changelog-per-version-file",
      "path": "notes/coredns-{version}.md"
    },
    {
      "component": "csi-driver-smb",
      "repo": "github.com/kubernetes-csi/csi-driver-smb",
      "form": "github-release"
    },
    {
      "component": "flannel",
      "repo": "github.com/flannel-io/flannel",
      "form": "github-release"
    },
    {
      "component": "fluentd",
      "repo": "github.com/fluent/fluentd",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "release-v-slash-date",
      "boundaryStyles": ["line-heading-v"]
    },
    {
      "component": "in-toto",
      "repo": "github.com/in-toto/in-toto",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-v-prefixed",
      "boundaryStyles": ["main-unreleased-parenthesised"]
    },
    {
      "component": "jaeger",
      "repo": "github.com/jaegertracing/jaeger",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-v-paren-date",
      "boundaryStyles": ["unreleased"]
    },
    {
      "component": "kube-state-metrics",
      "repo": "github.com/kubernetes/kube-state-metrics",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-v-slash-date",
      "boundaryStyles": ["unreleased"],
      "innerHeadingStyles": ["note-first"]
    },
    {
      "component": "node-exporter",
      "repo": "github.com/prometheus/node_exporter",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-slash-date",
      "boundaryStyles": ["main-unreleased-parenthesised"]
    },
    {
      "component": "openfga",
      "repo": "github.com/openfga/openfga",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-bracketed-date",
      "boundaryStyles": ["prerelease-linked-paren-date"]
    },
    {
      "component": "opentelemetry-collector",
      "repo": "github.com/open-telemetry/opentelemetry-collector",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-dual-second",
      "boundaryStyles": ["unreleased"]
    },
    {
      "component": "prometheus",
      "repo": "github.com/prometheus/prometheus",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-slash-date",
      "boundaryStyles": ["main-unreleased"]
    },
    {
      "component": "traefik",
      "repo": "github.com/traefik/traefik",
      "form": "changelog-file",
      "path": "CHANGELOG.md",
      "headingStyle": "version-linked-paren-date",
      "boundaryStyles": ["prerelease-linked-paren-date"]
    },
    {
      "component": "tuf",
      "repo": "github.com/theupdateframework/python-tuf",
      "form": "changelog-file",
      "path": "docs/CHANGELOG.md",
      "headingStyle": "version-v-prefixed",
      "boundaryStyles": ["main-unreleased-parenthesised"]
    },
    {
      "component": "vault",
      "repo": "github.com/hashicorp/vault",
      "form": "post-tag"
    }
  ]
}
