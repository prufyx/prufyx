    "name": "trivy-operator",
    "repo": "github.com/aquasecurity/trivy-operator",
    "component": "pkg:github/aquasecurity/trivy-operator",
    "factProject": "trivy_operator",
    "tagPrefixes": ["v"],
    "minFrom": "0.31",
    "attest": true,
    "paths": [
      {"path": "deploy/helm/crds", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
