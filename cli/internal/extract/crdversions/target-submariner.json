{
  "schema": "prufyx.io/crd-version-target/v1",
  "target": {
    "project": "submariner",
    "name": "Submariner",
    "repo": "github.com/submariner-io/submariner",
    "component": "pkg:github/submariner-io/submariner",
    "factProject": "submariner",
    "tagPrefixes": ["v"],
    "minFrom": "0.22",
    "paths": [
      {"path": "deploy/crds", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
