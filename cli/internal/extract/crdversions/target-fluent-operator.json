{
  "schema": "prufyx.io/crd-version-target/v1",
  "target": {
    "project": "fluent-operator",
    "catalog": "community",
    "name": "fluent-operator",
    "repo": "github.com/fluent/fluent-operator",
    "component": "pkg:github/fluent/fluent-operator",
    "factProject": "fluent_operator",
    "tagPrefixes": ["v"],
    "minFrom": "3.5",
    "attest": true,
    "paths": [
      {"path": "config/crd/bases", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
