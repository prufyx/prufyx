    "name": "OVN-Kubernetes",
    "repo": "github.com/ovn-kubernetes/ovn-kubernetes",
    "component": "pkg:github/ovn-kubernetes/ovn-kubernetes",
    "factProject": "ovn_kubernetes",
    "tagPrefixes": ["v"],
    "minFrom": "1.0",
    "paths": [
      {"path": "helm/ovn-kubernetes/crds", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
