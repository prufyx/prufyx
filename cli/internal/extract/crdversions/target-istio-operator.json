{
  "schema": "prufyx.io/crd-version-target/v1",
  "target": {
    "project": "istio-operator",
    "catalog": "community",
    "name": "istio-operator",
    "repo": "github.com/banzaicloud/istio-operator",
    "component": "pkg:github/banzaicloud/istio-operator",
    "factProject": "istio_operator",
    "tagPrefixes": ["", "v"],
    "minFrom": "2.12",
    "paths": [
      {"path": "config/crd/bases", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"},
      {"path": "internal/assets/manifests/base/crds", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"},
      {"path": "internal/assets/manifests/base/files", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
