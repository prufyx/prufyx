{
  "schema": "prufyx.io/crd-version-target/v1",
  "target": {
    "project": "openchoreo",
    "name": "OpenChoreo",
    "repo": "github.com/openchoreo/openchoreo",
    "component": "pkg:github/openchoreo/openchoreo",
    "factProject": "openchoreo",
    "tagPrefixes": ["v"],
    "minFrom": "0.16",
    "paths": [
      {"path": "config/crd/bases", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": []
  }
}
