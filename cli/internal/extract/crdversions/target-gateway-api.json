{
  "schema": "prufyx.io/crd-version-target/v1",
  "target": {
    "project": "gateway-api",
    "catalog": "community",
    "name": "Gateway API",
    "repo": "github.com/kubernetes-sigs/gateway-api",
    "component": "pkg:github/kubernetes-sigs/gateway-api",
    "factProject": "gateway_api",
    "tagPrefixes": ["v"],
    "minFrom": "1.1",
    "attest": true,
    "profileAttestation": true,
    "paths": [
      {"path": "config/crd/standard", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
    ],
    "exclude": [
      {"path": "tools/openapi-generator/tests/invalid_crd.yaml", "repo": "github.com/kubernetes-sigs/gateway-api", "reason": "OpenAPI generator negative test input, not an installation manifest", "evidence": "https://github.com/kubernetes-sigs/gateway-api/blob/e26d183dbbc1bb782b78addbd26faba03955c152/tools/openapi-generator/main_test.go#L31 passes this file only to the OpenAPI generator negative test; the full-tree guard voids this exclusion if any installation referrer appears."}
    ],
    "declaredChannel": "standard",
    "channels": [
      {"name": "experimental", "paths": [
        {"path": "config/crd/experimental", "directory": true, "match": "^[^.][^/]*\\.ya?ml$", "guard": "(?i)crd"}
      ]}
    ]
  }
}
