{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "auth": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer"
        },
        "legacyFlag": {
          "type": "boolean"
        },
        "legacyMap": {
          "type": "object"
        },
        "keep": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer"
        }
      }
    }
  }
}
